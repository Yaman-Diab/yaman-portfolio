---
import { portfolioRepository } from '@/app/container';
import { localeParams, routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import BaseLayout from '@/presentation/layouts/BaseLayout.astro';
import About from '@/presentation/sections/About.astro';
import Expertise from '@/presentation/sections/Expertise.astro';
import Hero from '@/presentation/sections/Hero.astro';
import Journey from '@/presentation/sections/Journey.astro';
import Work from '@/presentation/sections/Work.astro';
import Faq from '@/presentation/sections/Faq.astro';

export function getStaticPaths() {
  return localeParams();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = portfolioRepository.getProfile(locale);
const projects = portfolioRepository.getProjects(locale);
---

<BaseLayout locale={locale} description={profile.metaDescription} profile={profile} pathFor={routes.home}>
  <Hero locale={locale} profile={profile} />
  <Work locale={locale} projects={projects} />
  <About locale={locale} profile={profile} />
  <Expertise locale={locale} groups={portfolioRepository.getExpertise(locale)} />
  <Journey
    locale={locale}
    career={portfolioRepository.getCareer(locale)}
    recognitions={portfolioRepository.getRecognitions(locale)}
  />
  <Faq faq={portfolioRepository.getFaq(locale)} />
</BaseLayout>

---
import { portfolioRepository } from '@/app/container';
import { localeParams, routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import Lab from '@/presentation/features/lab/Lab.astro';
import BaseLayout from '@/presentation/layouts/BaseLayout.astro';
import { useUi } from '@/presentation/i18n/ui';

export function getStaticPaths() {
  return localeParams();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUi(locale);
const profile = portfolioRepository.getProfile(locale);
---

<BaseLayout locale={locale} title={t.lab.title} description={t.lab.description} profile={profile} pathFor={routes.lab}>
  <Lab locale={locale} />
</BaseLayout>

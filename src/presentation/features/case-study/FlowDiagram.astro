---
/**
 * A project's plan as a compact, interactive stepper: numbered steps on one
 * rail, one step open at a time. It walks through the steps on its own while
 * in view, and stops the moment the visitor picks a step (scripts/flow.ts).
 * Without JavaScript every step and its detail stay visible as a list.
 */
import type { Flow } from '@/domain/entities/project';

interface Props {
  flow: Flow;
}

const { flow } = Astro.props;
const id = `flow-${Math.random().toString(36).slice(2, 8)}`;
const pad = (n: number) => String(n).padStart(2, '0');
const total = flow.nodes.length;
---

<figure class="flow" data-flow style={`--n:${total}`}>
  <div class="flow__rail" aria-hidden="true"><span class="flow__fill" data-flow-fill></span></div>

  <ol class="flow__steps" role="tablist">
    {
      flow.nodes.map((node, i) => (
        <li role="presentation">
          <button
            class="flow__step"
            type="button"
            role="tab"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-flow-step={i}
          >
            <span class="flow__num">{pad(i + 1)}</span>
            <span class="flow__label">{node.label}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="flow__panels">
    {
      flow.nodes.map((node, i) => (
        <div
          class="flow__panel"
          role="tabpanel"
          id={`${id}-panel-${i}`}
          aria-labelledby={`${id}-tab-${i}`}
          data-flow-panel={i}
          data-active={i === 0 ? '' : undefined}
        >
          <span class="flow__of" dir="ltr">
            {pad(i + 1)} / {pad(total)}
          </span>
          <strong>{node.label}</strong>
          {node.detail && <span class="flow__detail">{node.detail}</span>}
        </div>
      ))
    }
  </div>

  {flow.caption && <figcaption>{flow.caption}</figcaption>}
</figure>

<style>
  .flow {
    position: relative;
    margin: 0;
  }

  /* ---------- Steps on a rail ---------- */

  .flow__rail {
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline: calc(50% / var(--n));
    height: 2px;
    background: color-mix(in srgb, var(--fg) 15%, transparent);
  }

  .flow__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: var(--from, left);
    transition: transform 600ms var(--ease-out);
  }

  :global([dir='rtl']) .flow__fill {
    --from: right;
  }

  .flow__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--space-2);
  }

  .flow__step {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .flow__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid color-mix(in srgb, var(--fg) 25%, transparent);
    border-radius: 50%;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    transition:
      background-color var(--dur) ease,
      border-color var(--dur) ease,
      color var(--dur) ease,
      scale var(--dur) var(--ease-out);
  }

  .flow__label {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg-muted);
    transition: color var(--dur) ease;
  }

  .flow__step.is-passed .flow__num {
    border-color: var(--accent);
    color: var(--accent);
  }

  .flow__step[aria-selected='true'] .flow__num {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--surface);
    scale: 1.12;
  }

  .flow__step[aria-selected='true'] .flow__label,
  .flow__step:hover .flow__label {
    color: var(--fg);
  }

  /* ---------- The open step ---------- */

  .flow__panels {
    display: grid;
    margin-block-start: var(--space-5);
  }

  .flow__panel {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.3rem;
    padding: var(--space-4) var(--space-5);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--rule));
    border-radius: 14px;
    background: var(--surface);
    opacity: 0;
    visibility: hidden;
    translate: 0 0.5rem;
    transition:
      opacity 350ms ease,
      translate 450ms var(--ease-out),
      visibility 0s linear 450ms;
  }

  .flow__panel[data-active] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 350ms ease,
      translate 450ms var(--ease-out),
      visibility 0s;
  }

  .flow__of {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    justify-self: start;
  }

  .flow__panel strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .flow__detail {
    color: var(--fg-muted);
  }

  figcaption {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  /* Without the script, it is a plain numbered list. */
  :global(html:not(.js)) .flow__panel {
    opacity: 1;
    visibility: visible;
    grid-area: auto;
  }

  /* Phones: a vertical rail, labels beside the numbers. */
  @media (max-width: 40rem) {
    .flow__rail {
      inset-block: 1.25rem;
      inset-inline: 1.2rem auto;
      width: 2px;
      height: auto;
    }

    .flow__fill {
      transform: scaleY(var(--p, 0));
      transform-origin: top;
    }

    .flow__steps {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .flow__step {
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      gap: var(--space-3);
      text-align: start;
    }
  }
</style>

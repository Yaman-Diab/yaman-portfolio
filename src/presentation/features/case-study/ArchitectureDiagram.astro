---
/**
 * The project's stack drawn as the layers it lives in: presentation on top,
 * data at the bottom, the domain between them when the project has one, and
 * the services, wiring and quality gates around them.
 *
 * Tools are sorted by name, so a new tool in facts.ts lands in a layer on
 * its own. A tool that matches nothing goes to the services row.
 */
import type { UiStrings } from '@/presentation/i18n/ui';

interface Props {
  stack: string[];
  /** The project's architecture sentence. A domain layer is drawn only when it names Clean Architecture. */
  architecture: string;
  strings: UiStrings['caseStudy']['layers'];
}

const { stack, architecture, strings } = Astro.props;

type Layer = 'base' | 'presentation' | 'domain' | 'data' | 'services' | 'quality' | 'di';
const RULES: [Layer, RegExp][] = [
  ['base', /^(flutter|dart)$/i],
  ['quality', /test|mocktail|githubactions/i],
  ['di', /getit|injectable/i],
  ['presentation', /bloc|cubit|gorouter|localization|animate|screenutil|skeleton|image_picker|cropper|video_player|map/i],
  ['domain', /dartz/i],
  ['data', /^dio$|supabase|secure_storage|sharedpreferences|cryptography|compress/i],
  ['services', /./],
];

const layers = new Map<Layer, string[]>();
for (const tool of stack) {
  const layer = RULES.find(([, pattern]) => pattern.test(tool.replace(/\s+/g, '')))?.[0] ?? 'services';
  layers.set(layer, [...(layers.get(layer) ?? []), tool]);
}

const hasDomain = /clean architecture/i.test(architecture);
const get = (layer: Layer) => layers.get(layer) ?? [];
const base = get('base');
---

<figure class="arch" data-inview>
  <figcaption class="arch__caption">
    <span>{strings.title}</span>
    {base.length > 0 && <span class="arch__base" dir="ltr">{base.join(' · ')}</span>}
  </figcaption>

  <div class="arch__grid">
    <div class="arch__stack">
      <div class="arch__layer arch__layer--presentation" data-reveal style="--i:0">
        <div class="arch__head">
          <span class="arch__index">01</span>
          <span class="arch__name">{strings.presentation}</span>
          <span class="arch__note">{strings.presentationNote}</span>
        </div>
        <ul class="arch__chips" dir="ltr">{get('presentation').map((tool) => <li>{tool}</li>)}</ul>
      </div>

      <span class="arch__arrow" aria-hidden="true"></span>

      {
        hasDomain && (
          <>
            <div class="arch__layer arch__layer--domain" data-reveal style="--i:1">
              <div class="arch__head">
                <span class="arch__index">02</span>
                <span class="arch__name">{strings.domain}</span>
                <span class="arch__note">{strings.domainNote}</span>
              </div>
              <ul class="arch__chips" dir="ltr">
                {strings.domainParts.map((part) => (
                  <li class="arch__chip--ghost">{part}</li>
                ))}
                {get('domain').map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </div>
            <span class="arch__arrow arch__arrow--up" aria-hidden="true" />
          </>
        )
      }

      <div class="arch__layer arch__layer--data" data-reveal style="--i:2">
        <div class="arch__head">
          <span class="arch__index">{hasDomain ? '03' : '02'}</span>
          <span class="arch__name">{strings.data}</span>
          <span class="arch__note">{strings.dataNote}</span>
        </div>
        <ul class="arch__chips" dir="ltr">{get('data').map((tool) => <li>{tool}</li>)}</ul>
      </div>

      {hasDomain && <p class="arch__rule">{strings.rule}</p>}
    </div>

    <div class="arch__side">
      {
        get('di').length > 0 && (
          <div class="arch__rail" data-reveal style="--i:3">
            <span class="arch__rail-name">{strings.di}</span>
            <ul class="arch__chips" dir="ltr">
              {get('di').map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        get('services').length > 0 && (
          <div class="arch__rail" data-reveal style="--i:4">
            <span class="arch__rail-name">{strings.services}</span>
            <ul class="arch__chips" dir="ltr">
              {get('services').map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        get('quality').length > 0 && (
          <div class="arch__rail arch__rail--quality" data-reveal style="--i:5">
            <span class="arch__rail-name">{strings.quality}</span>
            <ul class="arch__chips" dir="ltr">
              {get('quality').map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</figure>

<style>
  .arch {
    margin: 0;
    padding: clamp(1.25rem, 0.8rem + 2vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--fg) 12%, transparent) 1px, transparent 0) 0 0 / 22px
        22px,
      var(--surface);
  }

  .arch__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-block-end: var(--space-5);
    font-family: var(--font-display);
    font-weight: 650;
  }

  .arch__base {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--fg-muted);
  }

  .arch__grid {
    display: grid;
    gap: var(--space-5);
  }

  .arch__stack {
    display: grid;
    justify-items: stretch;
  }

  .arch__layer {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-inline-start: 4px solid var(--brand-ink, var(--accent));
    border-radius: 14px;
    background: var(--bg);
  }

  .arch__layer--domain {
    border-inline-start-color: var(--brand-accent-ink, var(--accent));
    background: color-mix(in srgb, var(--brand-ink, var(--accent)) 7%, var(--bg));
  }

  .arch__layer--data {
    border-inline-start-color: var(--fg);
  }

  .arch__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .arch__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .arch__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .arch__note {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .arch__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global([dir='rtl']) .arch__chips {
    justify-content: flex-end;
  }

  .arch__chips li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .arch__chips .arch__chip--ghost {
    border-style: dashed;
    background: transparent;
    color: var(--fg-muted);
  }

  /* The dependency arrow between two layers. */
  .arch__arrow {
    position: relative;
    justify-self: center;
    width: 2px;
    height: 1.75rem;
    background: var(--fg-muted);
  }

  .arch__arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--fg-muted);
    border-bottom: 2px solid var(--fg-muted);
    translate: -50% 0;
    rotate: 45deg;
  }

  .arch__arrow--up::after {
    top: 0;
    bottom: auto;
    rotate: -135deg;
  }

  .arch__rule {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .arch__side {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .arch__rail {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--rule);
    border-radius: 14px;
  }

  .arch__rail--quality {
    border-style: solid;
    border-color: color-mix(in srgb, var(--ok) 45%, var(--rule));
    background: color-mix(in srgb, var(--ok) 6%, transparent);
  }

  .arch__rail-name {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (min-width: 60rem) {
    .arch__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
</style>

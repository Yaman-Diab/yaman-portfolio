---
import type { ImageMetadata } from 'astro';
import { routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import type { Project } from '@/domain/entities/project';
import DeviceFrame from '@/presentation/components/DeviceFrame.astro';
import Icon from '@/presentation/components/Icon.astro';
import StatusPill from '@/presentation/components/StatusPill.astro';
import StoreBadge from '@/presentation/components/StoreBadge.astro';
import { useUi } from '@/presentation/i18n/ui';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import FlowDiagram from './FlowDiagram.astro';
import { liveScreens } from './interactive';
import ScreenGallery from './ScreenGallery.astro';
import { brandStyle, splashOf } from './splash';
import SyncQueueDemo from './SyncQueueDemo.astro';
import VerificationDemo from './VerificationDemo.astro';

interface Props {
  locale: Locale;
  project: Project;
  next: Project;
}

const { locale, project, next } = Astro.props;
const t = useUi(locale);
const altLang = locale === 'ar' ? 'en' : 'ar';
const logo = project.brand.logo as ImageMetadata | undefined;
const Live = liveScreens[project.slug] ?? [];
const pad = (n: number) => String(n).padStart(2, '0');

const chapters = [
  { id: 'problem', label: t.caseStudy.problem },
  { id: 'my-part', label: t.caseStudy.myPart },
  { id: 'hard-parts', label: t.caseStudy.challenges },
  { id: 'architecture', label: t.caseStudy.architecture },
  { id: 'outcome', label: t.caseStudy.outcome },
];
---

<article class="case" style={brandStyle(project)}>
  <!-- ---------- Hero: the project in its own colours, like its store page ---------- -->
  <header class="case-hero theme-dark">
    <div class="case-hero__bg" aria-hidden="true">
      <span class="case-hero__glow"></span>
      <span class="case-hero__stripes"></span>
      {
        logo && project.brand.logoKind === 'wordmark' ? (
          <img class="case-hero__watermark" src={logo.src} alt="" />
        ) : (
          <span class="case-hero__watermark case-hero__watermark--word">{project.name}</span>
        )
      }
    </div>

    <div class="wrap case-hero__layout">
      <div class="case-hero__copy">
        <a class="case-hero__back" href={routes.section(locale, 'work')}>
          <Icon name="arrowRight" flip class="case-hero__back-icon" />
          {t.caseStudy.back}
        </a>

        <div class="case-hero__identity">
          <span class:list={['app-tile', logo && `app-tile--${project.brand.logoKind}`]} aria-hidden="true">
            {logo ? <img src={logo.src} alt="" /> : <span>{project.name.slice(0, 1)}</span>}
          </span>
          <div>
            <h1 class="case-hero__title">{project.name}</h1>
            <p class="case-hero__alt" lang={altLang} dir={altLang === 'ar' ? 'rtl' : 'ltr'}>
              {project.altName} · {project.tagline}
            </p>
          </div>
        </div>

        <p class="case-hero__summary">{project.summary}</p>

        <ul class="case-hero__facts">
          <li><StatusPill status={project.status} label={project.statusLabel} /></li>
          <li>{project.platforms}</li>
          <li dir="ltr">{project.year}</li>
        </ul>

        <p class="case-hero__role"><span>{t.caseStudy.role}</span>{project.role}</p>

      </div>

      <div class="case-hero__device">
        {/* The way to get or read the app sits beside the phone, on the side facing the text. */}
        {
          project.links.length > 0 && (
            <div class="case-hero__links">
              {project.links.map((link) =>
                link.kind === 'store' ? (
                  <StoreBadge href={link.url} locale={locale} />
                ) : (
                  <a class="case-hero__cta" href={link.url} rel="noopener" data-magnetic="0.25">
                    <span data-magnetic-label>
                      <Icon name="github" />
                      {link.label}
                    </span>
                  </a>
                ),
              )}
            </div>
          )
        }
        <div class="case-hero__phone-wrap">
        <DeviceFrame
          screens={project.screens}
          appName={project.name}
          sizes="(min-width: 64rem) 19rem, 62vw"
          interactive
          eager
          labels={t.caseStudy.device}
          class="case-hero__phone"
        >
          {Live.map((Screen) => <Screen slot="screens" locale={locale} />)}
        </DeviceFrame>
        <p class="case-hero__hint">{t.caseStudy.tapHint}</p>
        </div>
      </div>
    </div>
  </header>

  <!-- ---------- Chapters rail: where you are in the story ---------- -->
  <nav class="chapters" aria-label={t.caseStudy.chapters} data-chapters>
    <ol>
      {
        chapters.map((chapter, i) => (
          <li>
            <a href={`#${chapter.id}`} data-chapter-link={chapter.id}>
              <span class="chapters__index">{pad(i + 1)}</span>
              <span class="chapters__label">{chapter.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <span class="chapters__track" aria-hidden="true"><span class="chapters__fill" data-chapters-fill></span></span>
  </nav>

  <!-- ---------- Problem and my part ---------- -->
  <div class="theme-paper">
    <div class="wrap case__body">
      <section class="case-block" id="problem" aria-labelledby="problem-title">
        <header class="case-block__head">
          <span class="case-block__index">01</span>
          <h2 id="problem-title">{t.caseStudy.problem}</h2>
        </header>
        <div class="case-block__content case__prose">
          {
            project.problem.map((paragraph, i) =>
              i === 0 ? (
                <p class="case__lead">
                  <span class="fill-text">{paragraph}</span>
                </p>
              ) : (
                <p>{paragraph}</p>
              ),
            )
          }
        </div>
      </section>

      <section class="case-block" id="my-part" aria-labelledby="my-part-title">
        <header class="case-block__head">
          <span class="case-block__index">02</span>
          <h2 id="my-part-title">{t.caseStudy.myPart}</h2>
        </header>
        <ol class="case-block__content duties" data-inview>
          {
            project.responsibilities.map((item, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="duties__num">{pad(i + 1)}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <ScreenGallery screens={project.screens} appName={project.name} label={t.caseStudy.screens} />

  <!-- ---------- Hard parts ---------- -->
  <section class="hard theme-tint" id="hard-parts" aria-labelledby="hard-title">
    <div class="wrap">
      <header class="hard__head">
        <span class="case-block__index">03</span>
        <h2 id="hard-title">{t.caseStudy.challenges}</h2>
        <p>{t.caseStudy.hardCount.replace('{n}', String(project.challenges.length))}</p>
      </header>

      <ol class="hard__list">
        {
          project.challenges.map((challenge, i) => (
            <li class="hard__item">
              <div class="hard__aside">
                <span class="hard__num" aria-hidden="true">
                  {pad(i + 1)}
                  <small>/{pad(project.challenges.length)}</small>
                </span>
                <h3>{challenge.title}</h3>
              </div>
              <div class="hard__main">
                <p class="hard__body">{challenge.body}</p>
              </div>
              {(challenge.flow || challenge.demo) && (
                <div class="hard__visual">
                  {challenge.flow && <FlowDiagram flow={challenge.flow} />}
                  {challenge.demo === 'sync-queue' && <SyncQueueDemo strings={t.syncDemo} />}
                  {challenge.demo === 'verification-states' && <VerificationDemo strings={t.verificationDemo} />}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- Architecture ---------- -->
  <section class="theme-paper" id="architecture" aria-labelledby="architecture-title">
    <div class="wrap case__body">
      <div class="case-block">
        <header class="case-block__head">
          <span class="case-block__index">04</span>
          <h2 id="architecture-title">{t.caseStudy.architecture}</h2>
        </header>
        <p class="case-block__content case__lead">{project.architecture}</p>
      </div>
      <ArchitectureDiagram stack={project.stack} architecture={project.architecture} strings={t.caseStudy.layers} />
    </div>
  </section>

  <!-- ---------- Outcome ---------- -->
  <section class="outcome" id="outcome" aria-labelledby="outcome-title">
    <div class="wrap">
      <header class="case-block__head">
        <span class="case-block__index">05</span>
        <h2 id="outcome-title">{t.caseStudy.outcome}</h2>
      </header>
      <ul class="outcome__list">
        {
          project.outcome.map((item) => (
            <li>
              <span class="outcome__tick" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---------- Next project, already in its own colours ---------- -->
  <a
    class="next-case"
    href={routes.project(locale, next.slug)}
    style={brandStyle(next)}
    data-splash={JSON.stringify(splashOf(next))}
  >
    <span class="wrap next-case__inner">
      <span class="next-case__label">{t.caseStudy.next}</span>
      <span class="next-case__name">{next.name}</span>
      <span class="next-case__tagline">{next.tagline}</span>
      <span class="next-case__go" aria-hidden="true"><Icon name="arrowRight" flip /></span>
    </span>
  </a>
</article>

<style>
  /* Small accents in light sections take the app's colour. */
  .case :global(.theme-paper),
  .case :global(.theme-tint) {
    --accent: var(--brand-ink);
  }

  /* ---------- Hero ---------- */

  .case-hero {
    position: relative;
    margin-block-start: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + clamp(1.5rem, 1rem + 2vw, 3rem)) clamp(3rem, 2rem + 4vw, 5rem);
    background: var(--brand-deep);
    color: var(--on-brand);
    overflow: clip;
    isolation: isolate;
    --fg-muted: color-mix(in srgb, var(--on-brand) 78%, transparent);
    --rule: color-mix(in srgb, var(--on-brand) 22%, transparent);
  }

  .case-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .case-hero__glow {
    position: absolute;
    inset-block-start: -10%;
    inset-inline-end: -10%;
    width: 75vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--brand), transparent 62%);
    opacity: 0.85;
  }

  /* Slanted bands at the angle of Yaman's mark: his signature on every project. */
  .case-hero__stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      63deg,
      transparent 0 120px,
      color-mix(in srgb, var(--on-brand) 4%, transparent) 120px 180px
    );
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
  }

  .case-hero__watermark {
    position: absolute;
    inset-block-end: -6%;
    inset-inline-start: -3%;
    width: min(85vw, 60rem);
    opacity: 0.08;
  }

  .case-hero__watermark--word {
    width: auto;
    font-family: var(--font-display);
    font-size: clamp(8rem, 4rem + 18vw, 22rem);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .case-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }

  .case-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .case-hero__back:hover {
    color: var(--on-brand);
  }

  .case-hero__back :global(.case-hero__back-icon) {
    rotate: 180deg;
    transition: translate var(--dur) var(--ease-out);
  }

  .case-hero__back:hover :global(.case-hero__back-icon) {
    translate: calc(var(--dir) * -3px) 0;
  }

  .case-hero__identity {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }

  .app-tile {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(4.5rem, 3.5rem + 4vw, 6.5rem);
    aspect-ratio: 1;
    border-radius: 23%;
    background: var(--brand);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--on-brand) 20%, transparent),
      0 24px 40px -20px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .app-tile span {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
  }

  .app-tile--wordmark img {
    width: 82%;
  }

  .app-tile--icon {
    background: var(--white);
  }

  .app-tile--icon img {
    width: 88%;
  }

  .case-hero__title {
    font-size: clamp(2.75rem, 1.5rem + 5vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  :global([dir='rtl']) .case-hero__title {
    line-height: 1.25;
    letter-spacing: 0;
  }

  .case-hero__alt {
    margin-block-start: 0.35rem;
    color: var(--fg-muted);
    font-size: var(--text-base);
  }

  .case-hero__summary {
    max-width: 36rem;
    margin-block-start: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .case-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
  }

  .case-hero__facts li {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand-deep) 55%, transparent);
    font-size: var(--text-sm);
    backdrop-filter: blur(6px);
  }

  .case-hero__role {
    display: grid;
    gap: 0.2rem;
    max-width: 36rem;
    margin-block-start: var(--space-5);
    font-weight: 500;
  }

  .case-hero__role span {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-hero__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .case-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: var(--on-brand);
    color: var(--brand-deep);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 16px 30px -16px rgba(0, 0, 0, 0.6);
    transition:
      translate var(--dur) var(--ease-out),
      box-shadow var(--dur) ease;
  }

  .case-hero__cta [data-magnetic-label] {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .case-hero__cta:hover {
    box-shadow: 0 22px 36px -16px rgba(0, 0, 0, 0.65);
  }

  /* Phone and its call to action side by side; on a phone screen the button goes under. */
  .case-hero__device {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--space-5);
    color: var(--on-brand);
  }

  .case-hero__phone-wrap {
    display: grid;
    justify-items: center;
  }

  @media (min-width: 64rem) {
    .case-hero__device {
      flex-direction: row;
      align-items: flex-end;
      justify-content: flex-end;
    }

    .case-hero__links {
      margin-block-end: 6.5rem;
    }
  }

  .case-hero__device :global(.case-hero__phone) {
    width: min(68vw, 19rem);
  }

  .case-hero__hint {
    margin-block-start: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  @media (min-width: 64rem) {
    .case-hero {
      min-height: 100svh;
      display: grid;
      align-items: center;
    }

    .case-hero__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .case-hero__copy > *,
    .case-hero__device {
      animation: case-rise 900ms var(--ease-out) both;
    }

    .case-hero__copy > :nth-child(2) {
      animation-delay: 80ms;
    }

    .case-hero__copy > :nth-child(3) {
      animation-delay: 160ms;
    }

    .case-hero__copy > :nth-child(n + 4) {
      animation-delay: 240ms;
    }

    .case-hero__device {
      animation-delay: 200ms;
    }
  }

  @keyframes case-rise {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  /* ---------- Chapter rail ---------- */

  .chapters {
    position: fixed;
    inset-block-start: 50%;
    inset-inline-start: 0.75rem;
    z-index: 40;
    display: none;
    translate: 0 -50%;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) ease;
  }

  .chapters.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .chapters ol {
    display: grid;
    gap: 0.15rem;
    padding-inline-start: 1rem;
  }

  .chapters a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.35rem;
    color: var(--ink-soft);
    font-size: var(--text-xs);
    text-decoration: none;
    opacity: 0.7;
    transition:
      opacity var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .chapters a:hover,
  .chapters a[aria-current='true'] {
    color: var(--navy);
    opacity: 1;
  }

  /* Only the numbers sit in the margin; a name appears beside its number on hover or focus. */
  .chapters a {
    position: relative;
  }

  .chapters__label {
    position: absolute;
    inset-inline-start: calc(100% + 0.5rem);
    top: 50%;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: calc(var(--dir) * -0.4rem) -50%;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) ease,
      translate var(--dur) var(--ease-out);
  }

  .chapters a:hover .chapters__label,
  .chapters a:focus-visible .chapters__label {
    opacity: 1;
    translate: 0 -50%;
  }

  .chapters a[aria-current='true'] .chapters__index {
    font-weight: 800;
  }

  .chapters__index {
    font-family: var(--font-mono);
    color: var(--brand-ink);
  }

  .chapters__track {
    position: absolute;
    inset-block: 0.4rem;
    inset-inline-start: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }

  .chapters__fill {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
    transform: scaleY(var(--progress, 0));
    transform-origin: top;
  }

  @media (min-width: 80rem) {
    .chapters {
      display: block;
    }
  }

  /* ---------- Sections ---------- */

  .case__body {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--section-pad);
  }

  .case-block {
    display: grid;
    gap: var(--space-5);
  }

  .case-block__head {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .case-block__head h2,
  .hard__head h2 {
    font-size: var(--text-2xl);
  }

  .case-block__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-ink);
  }

  .case__prose {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .case__prose p:not(.case__lead) {
    color: var(--fg-muted);
  }

  .case__lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  /* The opening line fills in as it is read, like ink. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fill-text {
        background: linear-gradient(
          calc(var(--dir) * 90deg),
          var(--fg) 0 50%,
          color-mix(in srgb, var(--fg) 22%, transparent) 50% 100%
        );
        background-size: 200% 100%;
        background-position: calc(50% + var(--dir) * 50%) 0;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: fill-ink linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
    }
  }

  @keyframes fill-ink {
    to {
      background-position: calc(50% - var(--dir) * 50%) 0;
    }
  }

  .duties {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .duties li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--surface);
  }

  .duties__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--brand-ink);
  }

  @media (min-width: 60rem) {
    .case-block {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-7);
      align-items: start;
    }

    .case-block__head {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 2rem);
    }
  }

  /* ---------- Hard parts ---------- */

  .hard {
    padding-block: var(--section-pad);
  }

  .hard__head {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-7);
  }

  .hard__head p {
    color: var(--fg-muted);
  }

  .hard__list {
    display: grid;
    gap: var(--space-5);
    counter-reset: hard;
  }

  .hard__item {
    display: grid;

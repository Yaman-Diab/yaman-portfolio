---
/**
 * Maan's verification screen as the state machine behind it: four states,
 * the moves allowed between them, and a phone showing what the citizen sees.
 * Only the moves the current state allows are enabled; the last move lights
 * its edge and a pulse runs along it.
 */
import type { UiStrings } from '@/presentation/i18n/ui';

interface Props {
  strings: UiStrings['verificationDemo'];
  rtl: boolean;
}

const { strings, rtl } = Astro.props;

type State = 'form' | 'pending' | 'approved' | 'rejected';
type Action = 'submit' | 'approve' | 'reject' | 'resubmit';

// Laid out left to right; mirrored for Arabic so the flow reads from the right.
const W = 640;
const at = (x: number, y: number) => ({ x: rtl ? W - x : x, y });
const NODES: Record<State, { x: number; y: number }> = {
  form: at(90, 140),
  pending: at(300, 140),
  approved: at(540, 60),
  rejected: at(540, 220),
};
const EDGES: { action: Action; from: State; to: State; bend: number }[] = [
  { action: 'submit', from: 'form', to: 'pending', bend: 0 },
  { action: 'approve', from: 'pending', to: 'approved', bend: 0 },
  { action: 'reject', from: 'pending', to: 'rejected', bend: 0 },
  { action: 'resubmit', from: 'rejected', to: 'pending', bend: 60 },
];

const R = 46;
/** A curve between two nodes, trimmed to their circles. */
const edgePath = (from: State, to: State, bend: number) => {
  const a = NODES[from];
  const b = NODES[to];
  const angle = Math.atan2(b.y - a.y, b.x - a.x);
  const sx = a.x + Math.cos(angle) * R;
  const sy = a.y + Math.sin(angle) * R;
  const ex = b.x - Math.cos(angle) * (R + 8);
  const ey = b.y - Math.sin(angle) * (R + 8);
  const mx = (sx + ex) / 2 + Math.sin(angle) * bend;
  const my = (sy + ey) / 2 - Math.cos(angle) * bend;
  return `M${sx.toFixed(1)} ${sy.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`;
};

const states = Object.keys(NODES) as State[];
const actions = EDGES.map((edge) => edge.action);
---

<div class="fsm" data-fsm data-edges={JSON.stringify(EDGES)} data-states={JSON.stringify(strings.states)}>
  <div class="fsm__graph">
    <svg viewBox={`0 0 ${W} 280`} role="img" aria-label={strings.title}>
      <defs>
        <marker id="fsm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" fill="currentColor"></path>
        </marker>
      </defs>
      {
        EDGES.map((edge) => (
          <g class="fsm__edge" data-edge={edge.action}>
            <path id={`fsm-${edge.action}`} d={edgePath(edge.from, edge.to, edge.bend)} marker-end="url(#fsm-arrow)" />
            <circle class="fsm__pulse" r="5">
              <animateMotion dur="0.9s" begin="indefinite" fill="freeze" data-pulse={edge.action}>
                <mpath href={`#fsm-${edge.action}`} />
              </animateMotion>
            </circle>
          </g>
        ))
      }
      {
        states.map((state) => (
          <g class="fsm__node" data-node={state} transform={`translate(${NODES[state].x} ${NODES[state].y})`}>
            <circle r={R} />
            <text y="5" text-anchor="middle">
              {strings.states[state].name}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <div class="fsm__side">
    <div class="fsm__phone">
      <span class="fsm__island" aria-hidden="true"></span>
      <p class="fsm__state-label">{strings.stateLabel}</p>
      <p class="fsm__state" data-fsm-name aria-live="polite">{strings.states.form.name}</p>
      <p class="fsm__body" data-fsm-body>{strings.states.form.body}</p>
    </div>

    <div class="fsm__actions">
      {
        actions.map((action) => (
          <button class="fsm__btn" type="button" data-fsm-action={action}>
            {strings.actions[action]}
          </button>
        ))
      }
      <button class="fsm__btn fsm__btn--ghost" type="button" data-fsm-reset>{strings.actions.reset}</button>
    </div>
    <p class="fsm__trace" dir="ltr" data-fsm-trace>state = form</p>
  </div>
</div>

<style>
  .fsm {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    color: var(--mist);
  }

  .fsm__graph svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .fsm__edge path {
    fill: none;
    stroke: var(--line-dark);
    stroke-width: 2;
    color: var(--line-dark);
    transition:
      stroke 400ms ease,
      color 400ms ease;
  }

  .fsm__edge.is-allowed path {
    stroke: var(--navy-text);
    color: var(--navy-text);
    stroke-dasharray: 6 6;
    animation: fsm-flow 1.2s linear infinite;
  }

  .fsm__edge.is-last path {
    stroke: var(--red-on-dark);
    color: var(--red-on-dark);
    stroke-width: 3;
    stroke-dasharray: none;
    animation: none;
  }

  .fsm__pulse {
    fill: var(--red-on-dark);
    opacity: 0;
  }

  .fsm__edge.is-last .fsm__pulse {
    opacity: 1;
  }

  .fsm__node circle {
    fill: #071a33;
    stroke: var(--line-dark);
    stroke-width: 2;
    transition:
      fill 500ms ease,
      stroke 500ms ease;
  }

  .fsm__node text {
    fill: var(--navy-text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }

  .fsm__node.is-current circle {
    fill: var(--blue);
    stroke: var(--white);
    filter: drop-shadow(0 0 18px rgba(143, 179, 227, 0.55));
  }

  .fsm__node.is-current text {
    fill: var(--white);
  }

  .fsm__node[data-node='approved'].is-current circle {
    fill: #17704a;
    filter: drop-shadow(0 0 18px rgba(111, 211, 168, 0.55));
  }

  .fsm__node[data-node='rejected'].is-current circle {
    fill: #b3323c;
    filter: drop-shadow(0 0 18px rgba(255, 92, 99, 0.55));
  }

  @keyframes fsm-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* ---------- Phone and controls ---------- */

  .fsm__side {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }

  .fsm__phone {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.5rem;
    width: min(100%, 15rem);
    aspect-ratio: 9 / 15;
    padding: 2.5rem 1.25rem 1.5rem;
    border: 6px solid #1b1d21;
    border-radius: 2.2rem;
    background: linear-gradient(180deg, #0b2140, #071a33);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 60px -30px rgba(0, 0, 0, 0.8);
    text-align: center;
  }

  .fsm__island {
    position: absolute;
    top: 0.7rem;
    left: 50%;
    width: 30%;
    height: 1.1rem;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  .fsm__state-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-text);
  }

  .fsm__state {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--white);
  }

  .fsm__body {
    color: var(--navy-text);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .fsm__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .fsm__btn {
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--white);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .fsm__btn[disabled] {
    border-color: var(--line-dark);
    background: transparent;
    color: var(--navy-text);
    opacity: 0.45;
    cursor: not-allowed;
  }

  .fsm__btn--ghost {
    border-color: var(--line-dark);
    background: transparent;
    color: var(--white);
  }

  .fsm__trace {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--blue-light);
  }

  @media (min-width: 60rem) {
    .fsm {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  type State = 'form' | 'pending' | 'approved' | 'rejected';
  interface Edge {
    action: string;
    from: State;
    to: State;
  }

  function mount(root: HTMLElement): void {
    const edges = JSON.parse(root.dataset.edges ?? '[]') as Edge[];
    const texts = JSON.parse(root.dataset.states ?? '{}') as Record<State, { name: string; body: string }>;
    const name = root.querySelector<HTMLElement>('[data-fsm-name]')!;
    const body = root.querySelector<HTMLElement>('[data-fsm-body]')!;
    const trace = root.querySelector<HTMLElement>('[data-fsm-trace]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-fsm-action]')];
    let state: State = 'form';

    const render = (last?: Edge) => {
      root.querySelectorAll('[data-node]').forEach((node) => {
        node.classList.toggle('is-current', node.getAttribute('data-node') === state);
      });
      root.querySelectorAll<SVGGElement>('[data-edge]').forEach((group) => {
        const edge = edges.find((candidate) => candidate.action === group.dataset.edge);
        group.classList.toggle('is-allowed', edge?.from === state);
        group.classList.toggle('is-last', edge === last);
      });
      // Only the moves the current state allows: the rule the real screen enforces.
      buttons.forEach((button) => {
        button.disabled = !edges.some((edge) => edge.from === state && edge.action === button.dataset.fsmAction);
      });
      name.textContent = texts[state].name;
      body.textContent = texts[state].body;
    };

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const edge = edges.find((candidate) => candidate.from === state && candidate.action === button.dataset.fsmAction);
        if (!edge) return;
        trace.textContent = `${edge.from} --${edge.action}--> ${edge.to}`;
        state = edge.to;
        render(edge);
        root.querySelector<SVGAnimateMotionElement>(`[data-pulse="${edge.action}"]`)?.beginElement();
      }),
    );

    root.querySelector('[data-fsm-reset]')?.addEventListener('click', () => {
      trace.textContent = `${state} --reset--> form`;
      state = 'form';
      render();
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-fsm]').forEach(mount);
</script>

---
/**
 * The Lab: four working experiments, each a full-screen scene with its own
 * backdrop. On wide screens the scenes stack: each one slides up over the
 * last, which settles back and dims (scripts in this file). Two come from
 * real case studies; one is the engine that draws this site; one shows how
 * the apps are laid out for both directions.
 */
import { routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import Icon from '@/presentation/components/Icon.astro';
import { useUi } from '@/presentation/i18n/ui';
import RtlMirror from './RtlMirror.astro';
import StateMachine from './StateMachine.astro';
import SyncEngine from './SyncEngine.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUi(locale);
const rtl = locale === 'ar';
const word = t.lab.glyph.placeholder;
---

<section class="lab-hero theme-dark" aria-labelledby="lab-title">
  <div class="wrap">
    <p class="eyebrow"><span>LAB</span> / {t.nav.lab}</p>
    <h1 class="lab-hero__title" id="lab-title">{t.lab.title}<span>.</span></h1>
    <p class="lab-hero__thin">{t.lab.thin}</p>
    <p class="lab-hero__intro">{t.lab.intro}</p>
    <ol class="lab-hero__index">
      <li><a href="#exp-glyph"><span>01</span>{t.lab.glyph.title}</a></li>
      <li><a href="#exp-sync"><span>02</span>{t.lab.sync.title}</a></li>
      <li><a href="#exp-fsm"><span>03</span>{t.lab.verify.title}</a></li>
      <li><a href="#exp-rtl"><span>04</span>{t.lab.rtl.title}</a></li>
    </ol>
  </div>
</section>

<div class="scenes" data-scenes>
  <!-- 01 · the glyph engine: the field is the backdrop -->
  <section class="scene scene--glyph theme-dark" id="exp-glyph" data-scene aria-labelledby="exp-glyph-title">
    <div class="scene__bg" data-glyph-play>
      <canvas
        data-glyph-field
        data-wide
        data-fill="0.55"
        data-shape={JSON.stringify({ kind: 'text', text: word, weight: 800 })}
        aria-hidden="true"></canvas>
    </div>
    <div class="wrap scene__inner scene__inner--split">
      <header class="scene__head">
        <span class="scene__num">01</span>
        <h2 id="exp-glyph-title">{t.lab.glyph.title}</h2>
        <p>{t.lab.glyph.body}</p>
      </header>
      <label class="glyph-input">
        <span>{t.lab.glyph.label}</span>
        <input type="text" maxlength="12" value={word} autocomplete="off" spellcheck="false" data-glyph-input />
      </label>
    </div>
  </section>

  <!-- 02 · the sync engine -->
  <section class="scene scene--sync theme-dark" id="exp-sync" data-scene aria-labelledby="exp-sync-title">
    <div class="scene__bg" aria-hidden="true"></div>
    <div class="wrap scene__inner">
      <header class="scene__head">
        <span class="scene__num">02</span>
        <h2 id="exp-sync-title">{t.lab.sync.title}</h2>
        <p>{t.lab.sync.body}</p>
        <a class="scene__from" href={routes.project(locale, 'engleazia')}>{t.lab.from}<Icon name="arrowRight" flip /></a>
      </header>
      <SyncEngine strings={t.syncDemo} />
    </div>
  </section>

  <!-- 03 · the state machine -->
  <section class="scene scene--fsm theme-dark" id="exp-fsm" data-scene aria-labelledby="exp-fsm-title">
    <div class="scene__bg" aria-hidden="true"></div>
    <div class="wrap scene__inner">
      <header class="scene__head">
        <span class="scene__num">03</span>
        <h2 id="exp-fsm-title">{t.lab.verify.title}</h2>
        <p>{t.lab.verify.body}</p>
        <a class="scene__from" href={routes.project(locale, 'maan')}>{t.lab.from}<Icon name="arrowRight" flip /></a>
      </header>
      <StateMachine strings={t.verificationDemo} rtl={rtl} />
    </div>
  </section>

  <!-- 04 · one screen, two directions -->
  <section class="scene scene--rtl theme-paper" id="exp-rtl" data-scene aria-labelledby="exp-rtl-title">
    <div class="scene__bg" aria-hidden="true"><span>ع</span><span>A</span></div>
    <div class="wrap scene__inner scene__inner--split">
      <header class="scene__head">
        <span class="scene__num">04</span>
        <h2 id="exp-rtl-title">{t.lab.rtl.title}</h2>
        <p>{t.lab.rtl.body}</p>
        <a class="scene__from" href={routes.project(locale, 'engleazia')}>{t.lab.from}<Icon name="arrowRight" flip /></a>
      </header>
      <RtlMirror strings={t.lab.rtl} rtl={rtl} />
    </div>
  </section>
</div>

<style>
  /* ---------- Opening ---------- */

  .lab-hero {
    margin-block-start: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + clamp(3rem, 2rem + 5vw, 7rem)) clamp(3rem, 2rem + 4vw, 6rem);
    background:
      radial-gradient(ellipse 60% 70% at 85% 20%, color-mix(in srgb, var(--blue) 22%, transparent), transparent 70%),
      var(--navy-deep);
  }

  .lab-hero__title {
    margin-block-start: var(--space-4);
    font-size: clamp(3.5rem, 1rem + 11vw, 11rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--white);
  }

  :global([dir='rtl']) .lab-hero__title {
    line-height: 1.25;
    letter-spacing: 0;
  }

  .lab-hero__title span {
    color: var(--red-on-dark);
  }

  .lab-hero__thin {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 200;
    color: var(--blue-light);
  }

  :global([dir='rtl']) .lab-hero__thin {
    font-weight: 300;
  }

  .lab-hero__intro {
    max-width: 40ch;
    margin-block-start: var(--space-5);
    color: var(--navy-text);
    font-size: var(--text-lg);
    font-weight: 300;
  }

  .lab-hero__index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-block-start: var(--space-7);
    border-block-start: 1px solid var(--line-dark);
  }

  .lab-hero__index a {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-4) var(--space-2);
    border-block-end: 1px solid var(--line-dark);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .lab-hero__index a:hover {
    color: var(--blue-light);
  }

  .lab-hero__index span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--red-on-dark);
  }

  /* ---------- Scenes ---------- */

  .scene {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    overflow: clip;
    isolation: isolate;
    --covered: 0;
  }

  .scene__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* The scene behind settles back and dims as the next one slides over it. */
  .scene__inner,
  .scene__bg {
    transform: scale(calc(1 - var(--covered) * 0.07));
    filter: brightness(calc(1 - var(--covered) * 0.55));
    transform-origin: 50% 0;
  }

  .scene__inner {
    position: relative;
    display: grid;
    gap: var(--space-6);
    width: 100%;
  }

  .scene__head {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
    pointer-events: auto;
  }

  .scene__num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 200;
    line-height: 1;
    color: var(--red-on-dark);
  }

  .scene--rtl .scene__num {
    color: var(--red);
  }

  .scene__head h2 {
    font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .scene__head p {
    color: var(--fg-muted);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-snug);
  }

  :global([dir='rtl']) .scene__head p {
    font-weight: 400;
  }

  .scene__from {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .scene__from:hover {
    text-decoration: underline;
  }

  @media (min-width: 64rem) {
    .scene__inner--split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    /* Stacked scenes: each sticks while the next one slides up over it. */
    .scene {
      position: sticky;
      inset-block-start: 0;
    }

    .scene + .scene {
      box-shadow: 0 -30px 60px -20px rgba(0, 0, 0, 0.45);
      border-start-start-radius: 32px;
      border-start-end-radius: 32px;
    }
  }

  /* 01 · the field fills the scene */
  .scene--glyph {
    background: #071a33;
  }

  .scene--glyph .scene__bg canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  .scene--glyph .scene__inner {
    pointer-events: none;
  }

  .scene--glyph .scene__inner--split {
    align-self: end;
  }

  .glyph-input {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: end;
    width: fit-content;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    background: color-mix(in srgb, var(--navy-deep) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--navy-text);
    font-size: var(--text-xs);
    pointer-events: auto;
  }

  :global([dir='rtl']) .glyph-input {
    padding: 0.4rem 1rem 0.4rem 0.4rem;
  }

  .glyph-input input {
    width: 12rem;
    min-height: 2.75rem;
    padding: 0.3rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    font: 600 1rem var(--font-display);
  }

  /* 02 · blueprint grid and a cool glow */
  .scene--sync {
    background: #06132a;
  }

  .scene--sync .scene__bg {
    background:
      radial-gradient(ellipse 50% 60% at 80% 30%, rgba(63, 114, 175, 0.35), transparent 70%),
      linear-gradient(rgba(143, 179, 227, 0.06) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(143, 179, 227, 0.06) 1px, transparent 1px) 0 0 / 48px 48px;
  }

  /* 03 · dots and a warm glow */
  .scene--fsm {
    background: #050e1c;
  }

  .scene--fsm .scene__bg {
    background:
      radial-gradient(ellipse 45% 55% at 15% 80%, rgba(255, 92, 99, 0.18), transparent 70%),
      radial-gradient(circle at 1px 1px, rgba(219, 226, 239, 0.12) 1px, transparent 0) 0 0 / 22px 22px;
  }

  /* 04 · light, with the two scripts as giant letters */
  .scene--rtl {
    background: var(--paper);
  }

  .scene--rtl .scene__bg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 4vw;
    font-family: var(--font-display);
    font-size: clamp(14rem, 8rem + 22vw, 34rem);
    font-weight: 800;
    line-height: 1;
    color: color-mix(in srgb, var(--navy) 5%, transparent);
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene__inner,
    .scene__bg {
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  import { morphGlyphField } from '@/presentation/scripts/glyph-field';

  // 01 · redraw the field as the word changes, a moment after typing stops.
  document.querySelectorAll<HTMLElement>('.scene--glyph').forEach((scene) => {
    const canvas = scene.querySelector<HTMLCanvasElement>('canvas');
    const input = scene.querySelector<HTMLInputElement>('[data-glyph-input]');
    if (!canvas || !input) return;
    let timer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        const text = input.value.trim().slice(0, 12);
        if (text) morphGlyphField(canvas, { kind: 'text', text, weight: 800 });
      }, 350);
    });
  });

  // Stacking: as a scene slides over the one before, that one settles back and dims.
  const stacked = window.matchMedia('(min-width: 64rem) and (prefers-reduced-motion: no-preference)');
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
  let queued = false;
  const update = () => {
    queued = false;
    scenes.forEach((scene, i) => {
      const next = scenes[i + 1];
      if (!next || !stacked.matches) {
        scene.style.setProperty('--covered', '0');
        return;
      }
      const top = next.getBoundingClientRect().top;
      const covered = Math.min(1, Math.max(0, 1 - top / window.innerHeight));
      scene.style.setProperty('--covered', covered.toFixed(3));
    });
  };
  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
</script>

---
/**
 * Experience and recognition as one stretch of the page, over loose strokes
 * that the scroll draws in (components/ScrollStrokes.astro). Two sections,
 * so the header's links still land on #experience and #recognition.
 */
import { routes } from '@/app/routes';
import type { Career, Recognition } from '@/domain/entities/career';
import type { Locale } from '@/domain/entities/locale';
import Icon from '@/presentation/components/Icon.astro';
import ScrollStrokes from '@/presentation/components/ScrollStrokes.astro';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  career: Career;
  recognitions: Recognition[];
}

const { locale, career, recognitions } = Astro.props;
const t = useUi(locale);
const { entry, education, milestones } = career;
---

<div class="journey theme-paper" data-strokes>
  <ScrollStrokes />

  <section class="journey__part" id="experience" aria-labelledby="experience-title">
    <div class="wrap">
      <header class="journey__head">
        <p class="eyebrow"><span>05</span> / {t.nav.experience}</p>
        <h2 class="journey__title" id="experience-title">{career.title}<span class="journey__dot">.</span></h2>
        <p class="journey__thin">{entry.duration}{t.comma}{entry.mode}</p>
      </header>

      <div class="journey__grid">
        <div class="journey__side">
          <article class="now-card">
            <p class="now-card__label"><span class="now-card__pulse" aria-hidden="true"></span>{t.career.now}</p>
            <h3>{entry.title}</h3>
            <p class="now-card__summary">{entry.summary}</p>
            <ul class="now-card__list">
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </article>

          <article class="school-card">
            <p class="school-card__label">{t.career.educationTitle}</p>
            <h3>{education.school}</h3>
            <p>{education.degree}</p>
            <p class="school-card__note">{education.note}</p>
          </article>
        </div>

        <div class="timeline">
          <p class="timeline__label">{t.career.timelineTitle}</p>
          <ol class="timeline__list" data-inview>
            {
              milestones.map((milestone, index) => (
                <li class="timeline__item" data-reveal style={`--i:${index}`}>
                  <span class="timeline__node" aria-hidden="true" />
                  <p class="timeline__year">
                    {milestone.year}
                  </p>
                  <div class="timeline__body">
                    <h4>{milestone.title}</h4>
                    <p>{milestone.body}</p>
                    {milestone.projectSlug && (
                      <a class="timeline__link" href={routes.project(locale, milestone.projectSlug)}>
                        {t.career.caseStudy}
                        <span class="visually-hidden">: {milestone.title}</span>
                        <Icon name="arrowRight" flip />
                      </a>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="journey__part journey__part--wins" id="recognition" aria-labelledby="recognition-title">
    <div class="wrap">
      <header class="journey__head">
        <p class="eyebrow"><span>06</span> / {t.recognition.title}</p>
        <h2 class="journey__title" id="recognition-title">{t.recognition.title}<span class="journey__dot">.</span></h2>
      </header>

      <ol class="wins" data-inview>
        {
          recognitions.map((item, index) => (
            <li class="wins__item" data-reveal style={`--i:${index}`}>
              <p class="wins__year">
                {item.year}
              </p>
              <div class="wins__text">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              {item.link && (
                <a class="wins__link" href={item.link.url} rel="noopener">
                  {item.link.label}
                  <Icon name="arrowUpRight" flip />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</div>

<style>
  .journey {
    position: relative;
    overflow: clip;
  }

  .journey__part {
    position: relative;
    z-index: 1;
    padding-block: var(--section-pad) 0;
  }

  .journey__part--wins {
    padding-block-end: var(--section-pad);
  }

  /* ---------- Headings ---------- */

  .journey__head {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-8);
  }

  .journey__title {
    margin-block-start: var(--space-2);
    font-size: clamp(2.6rem, 1rem + 6.5vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  :global([dir='rtl']) .journey__title {
    line-height: 1.3;
    letter-spacing: 0;
  }

  .journey__dot {
    color: var(--red);
  }

  .journey__thin {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.8vw, 2.4rem);
    font-weight: 200;
    color: var(--blue);
  }

  :global([dir='rtl']) .journey__thin {
    font-weight: 300;
  }

  /* ---------- Experience ---------- */

  .journey__grid {
    display: grid;
    gap: var(--space-7);
  }

  .journey__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .now-card,
  .school-card {
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 82%, transparent);
    backdrop-filter: blur(8px);
  }

  .now-card {
    border-color: color-mix(in srgb, var(--blue) 30%, var(--rule));
    box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--navy) 50%, transparent);
  }

  .now-card__label,
  .school-card__label,
  .timeline__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  :global([dir='rtl']) .now-card__label,
  :global([dir='rtl']) .school-card__label,
  :global([dir='rtl']) .timeline__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .now-card__label {
    color: var(--red);
  }

  .now-card__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--red) 18%, transparent);
  }

  .now-card h3,
  .school-card h3 {
    font-size: clamp(1.3rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .now-card__summary {
    color: var(--fg-muted);
  }

  .now-card__list {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
  }

  .now-card__list li {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: var(--text-sm);
  }

  .now-card__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7em;
    width: 0.6rem;
    height: 1.5px;
    background: var(--blue);
  }

  .school-card__note {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  /* ---------- Timeline ---------- */

  .timeline {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .timeline__list {
    position: relative;
    display: grid;
    border-inline-start: 1px solid var(--line-strong);
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: 0 0 var(--space-6) var(--space-6);
  }

  :global([dir='rtl']) .timeline__item {
    padding: 0 var(--space-6) var(--space-6) 0;
  }

  .timeline__node {
    position: absolute;
    inset-inline-start: -6.5px;
    top: 0.5rem;
    width: 12px;
    height: 12px;
    border: 2px solid var(--blue);
    border-radius: 50%;
    background: var(--paper);
  }

  .timeline__item:first-child .timeline__node {
    border-color: var(--red);
    background: var(--red);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--red) 18%, transparent);
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--blue);
    text-align: start;
  }

  .timeline__body {
    display: grid;
    gap: 0.35rem;
    max-width: 38rem;
  }

  .timeline__body h4 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .timeline__body p {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .timeline__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin-block-start: 0.25rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--fg);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .timeline__link:hover {
    background: var(--navy);
    color: var(--white);
  }

  @media (min-width: 60rem) {
    .journey__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .journey__side {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 2rem);
      align-self: start;
    }
  }

  /* ---------- Recognition ---------- */

  .wins {
    border-block-start: 1px solid var(--fg);
  }

  .wins__item {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--rule);
  }

  .wins__year {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem);
    font-weight: 200;
    line-height: 1;
    color: var(--blue);
    text-align: start;
  }

  .wins__text {
    display: grid;
    gap: var(--space-2);
  }

  .wins__text h3 {
    font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .wins__text p {
    max-width: 52ch;
    color: var(--fg-muted);
  }

  .wins__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    height: fit-content;
    padding: 0.55rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .wins__link:hover {
    background: var(--navy);
    color: var(--white);
  }

  @media (min-width: 60rem) {
    .wins__item {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      align-items: start;
    }
  }
</style>

---
/**
 * Questions people ask, as native disclosure widgets: keyboard and screen
 * readers get them for free, and they work without JavaScript.
 */
import type { Faq } from '@/domain/entities/career';
import Icon from '@/presentation/components/Icon.astro';

interface Props {
  faq: Faq;
}

const { faq } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section theme-paper faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__layout">
    <header class="faq__head">
      <p class="eyebrow"><span>07</span> / FAQ</p>
      <h2 class="faq__title" id="faq-title">{faq.title}<span class="faq__dot">.</span></h2>
      <p class="faq__intro">{faq.intro}</p>
      <a class="faq__link" href={faq.link.url} rel="noopener" data-magnetic="0.3">
        <span data-magnetic-label>{faq.link.label}</span>
        <Icon name="arrowUpRight" flip />
      </a>
    </header>

    <div class="faq__list">
      {
        faq.items.map((item, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary>
              <span class="faq__num">{pad(i + 1)}</span>
              <span class="faq__q">{item.question}</span>
              <span class="faq__toggle" aria-hidden="true" />
            </summary>
            <p class="faq__a">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__layout {
    display: grid;
    gap: var(--space-7);
  }

  .faq__head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .faq__title {
    font-size: clamp(2.4rem, 1rem + 5vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  :global([dir='rtl']) .faq__title {
    line-height: 1.3;
    letter-spacing: 0;
  }

  .faq__dot {
    color: var(--red);
  }

  .faq__intro {
    max-width: 34ch;
    color: var(--fg-muted);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-snug);
  }

  :global([dir='rtl']) .faq__intro {
    font-weight: 400;
  }

  .faq__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .faq__link:hover {
    background: var(--navy);
    color: var(--white);
  }

  /* ---------- Questions ---------- */

  .faq__list {
    border-block-start: 1px solid var(--fg);
  }

  .faq__item {
    border-block-end: 1px solid var(--rule);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--fg-muted);
    transition: color var(--dur) ease;
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.5rem);
    font-weight: 500;
    line-height: 1.35;
    transition: color var(--dur) ease;
  }

  .faq__item summary:hover .faq__q,
  .faq__item[open] .faq__q {
    font-weight: 700;
  }

  .faq__item[open] .faq__num {
    color: var(--red);
  }

  /* A plus that turns into a cross. */
  .faq__toggle {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition:
      rotate 500ms var(--ease-out),
      background-color var(--dur) ease,
      border-color var(--dur) ease;
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.9rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }

  .faq__toggle::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__toggle {
    rotate: 45deg;
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }

  .faq__a {
    max-width: 60ch;
    padding: 0 0 var(--space-5);
    padding-inline-start: calc(0.8rem * 1.6 + var(--space-5));
    color: var(--fg-muted);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a {
      animation: faq-open 500ms var(--ease-out);
    }
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  @media (min-width: 60rem) {
    .faq__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .faq__head {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 2rem);
      align-self: start;
    }
  }
</style>

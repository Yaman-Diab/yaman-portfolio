---
import { routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import type { Project } from '@/domain/entities/project';
import PhoneFrame from '@/presentation/components/PhoneFrame.astro';
import StatusPill from '@/presentation/components/StatusPill.astro';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const t = useUi(locale);
---

<section class="section theme-paper" id="work">
  <div class="wrap">
    <header class="work__head">
      <h2 class="section__title">{t.work.title}</h2>
      <p class="section__intro">{t.work.intro}</p>
    </header>

    <ul class="work__list">
      {
        projects.map((project) => (
          <li data-inview>
            <a
              class="project theme-tint"
              href={routes.project(locale, project.slug)}
              aria-label={`${project.name}: ${project.tagline}. ${t.work.open}`}
            >
              <div class="project__text">
                <h3 class="project__name" style={`view-transition-name: project-${project.slug}`}>
                  {project.name}
                </h3>
                <p class="project__tagline">{project.tagline}</p>
                <p class="project__teaser">{project.teaser}</p>
                <p class="project__meta">
                  <StatusPill status={project.status} label={project.statusLabel} />
                  <span class="project__year">{project.year}</span>
                </p>
                <span class="project__cta">
                  {t.work.open}
                  <span class="project__arrow" aria-hidden="true" />
                </span>
              </div>

              <div class="project__phones" aria-hidden="true">
                {project.screens.map((screen) => (
                  <PhoneFrame
                    screen={screen}
                    appName={project.name}
                    sizes="(min-width: 60rem) 12rem, 28vw"
                    decorative
                  />
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-7);
  }

  .work__list {
    display: grid;
    gap: var(--space-6);
  }

  /* ---------- One project ---------- */

  .project {
    --pad: clamp(1.5rem, 1rem + 2.6vw, 3.5rem);
    display: grid;
    gap: var(--space-6);
    padding: var(--pad) var(--pad) 0;
    overflow: clip;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-out);
  }

  .project:hover,
  .project:focus-visible {
    background: var(--mist);
  }

  .project__text {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    justify-items: start;
  }

  .project__name {
    font-size: var(--text-3xl);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  [dir='rtl'] .project__name {
    font-size: calc(var(--text-3xl) * 0.9);
    letter-spacing: 0;
  }

  .project__tagline {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .project__teaser {
    max-width: 38ch;
    color: var(--fg-muted);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-2);
  }

  .project__year {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .project__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-block-start: var(--space-3);
    color: var(--accent);
    font-weight: 600;
  }

  /* A chevron pointing the way the page reads. */
  .project__arrow {
    width: 0.5em;
    height: 0.5em;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    transform: rotate(calc(var(--dir) * 45deg));
    transition: translate var(--dur) var(--ease-out);
  }

  .project:hover .project__arrow,
  .project:focus-visible .project__arrow {
    translate: calc(var(--dir) * 0.3rem) 0;
  }

  /* ---------- Phones ----------
   * Three screens stand at the bottom edge of the panel and are cut off by it.
   * They rise when the panel scrolls into view, and fan out on hover.
   */

  .project__phones {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4%;
    padding-inline: 2%;
  }

  .project__phones > :global(.phone) {
    flex: 0 0 29%;
    translate: 0 16%;
    transition:
      translate var(--dur-slow) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out);
  }

  .project__phones > :global(.phone:nth-child(2)) {
    translate: 0 7%;
  }

  :global(.js) li:not(.is-inview) .project__phones > :global(.phone) {
    translate: 0 45%;
  }

  @media (hover: hover) {
    .project:hover .project__phones > :global(.phone:nth-child(1)) {
      translate: calc(var(--dir) * -6%) 11%;
      rotate: calc(var(--dir) * -3deg);
    }

    .project:hover .project__phones > :global(.phone:nth-child(2)) {
      translate: 0 2%;
    }

    .project:hover .project__phones > :global(.phone:nth-child(3)) {
      translate: calc(var(--dir) * 6%) 11%;
      rotate: calc(var(--dir) * 3deg);
    }
  }

  @media (min-width: 60rem) {
    .project {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      column-gap: var(--space-7);
    }

    .project__text {
      align-self: center;
      padding-block-end: var(--pad);
    }

    /* Every other project puts its phones first, for rhythm down the page. */
    .work__list > li:nth-child(even) .project__text {
      order: 2;
    }
  }
</style>

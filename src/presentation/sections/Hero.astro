---
import { routes } from '@/app/routes';
import type { Locale } from '@/domain/entities/locale';
import type { Profile } from '@/domain/entities/profile';
import Icon from '@/presentation/components/Icon.astro';
import { MARK_SHAPE } from '@/presentation/components/mark';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  profile: Profile;
}

const { locale, profile } = Astro.props;
const t = useUi(locale);

---

<section class="hero theme-dark" aria-labelledby="hero-title">
  <!-- Yaman's mark, drawn in code symbols that scatter from the pointer (scripts/glyph-field.ts). -->
  <canvas class="hero__field" data-glyph-field data-float data-align="end" data-fill="0.72" data-shape={JSON.stringify(MARK_SHAPE)} aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <p class="hero__eyebrow hero__rise" style="--i:0">
      <span class="hero__index">01</span>
      <span class="hero__slash">/</span>
      <span>{profile.role}</span>
      <span class="hero__badge"><span class="hero__pulse" aria-hidden="true"></span>{profile.availability}</span>
    </p>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__name hero__rise" style="--i:1">{profile.name}<span class="hero__dot">.</span></span>
      <span class="hero__script hero__rise" style="--i:2">{t.hero.script}</span>
    </h1>

    <p class="hero__lead hero__rise" style="--i:3">{profile.positioning}</p>

    <div class="hero__actions hero__rise" style="--i:4">
      <a class="pill pill--solid" href={routes.section(locale, 'work')} data-magnetic>
        <span data-magnetic-label>{t.hero.primaryAction}</span>
        <Icon name="arrowDown" />
      </a>
      <a class="pill pill--line" href={routes.section(locale, 'contact')} data-magnetic>
        <span data-magnetic-label>{t.hero.secondaryAction}</span>
      </a>
      <span class="hero__socials">
        <a class="hero__social" href={profile.contact.github} rel="me noopener" aria-label="GitHub" data-magnetic="0.5">
          <Icon name="github" />
        </a>
        <a class="hero__social" href={profile.contact.linkedin} rel="me noopener" aria-label="LinkedIn" data-magnetic="0.5">
          <Icon name="linkedin" />
        </a>
      </span>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* The hero runs under the floating header. */
    margin-block-start: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + clamp(2.5rem, 1.5rem + 5vw, 6rem)) clamp(4rem, 3rem + 4vw, 7rem);
    background:
      radial-gradient(ellipse 70% 60% at 85% 35%, color-mix(in srgb, var(--blue) 22%, transparent), transparent 70%),
      var(--navy-deep);
    overflow: clip;
    isolation: isolate;
  }

  :global([dir='rtl']) .hero {
    background:
      radial-gradient(ellipse 70% 60% at 15% 35%, color-mix(in srgb, var(--blue) 22%, transparent), transparent 70%),
      var(--navy-deep);
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
  }

  /* On a phone the mark sits behind the text, so it steps back. */
  @media (max-width: 45rem) {
    .hero__field {
      opacity: 0.4;
    }
  }

  /* Film grain and a fade under the copy, so text always reads over the glyphs. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      calc(var(--dir) * 90deg),
      color-mix(in srgb, var(--navy-deep) 80%, transparent) 0%,
      color-mix(in srgb, var(--navy-deep) 30%, transparent) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
  }

  .hero__inner a,
  .hero__inner .hero__badge {
    pointer-events: auto;
  }

  /* ---------- Copy ---------- */

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mist);
  }

  :global([dir='rtl']) .hero__eyebrow {
    letter-spacing: 0.02em;
    font-family: var(--font-body);
    font-weight: 600;
  }

  .hero__index {
    font-family: var(--font-mono);
    color: var(--red-on-dark);
    font-weight: 700;
  }

  .hero__slash {
    opacity: 0.4;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: 0.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    color: var(--navy-text);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .hero__pulse {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok-on-dark);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: pulse 2s ease-out infinite;
  }

  .hero__title {
    display: grid;
    margin-block-start: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 0.8rem + 8vw, 8.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--white);
  }

  :global([dir='rtl']) .hero__name {
    font-size: clamp(3rem, 1rem + 9vw, 9.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .hero__dot {
    color: var(--red-on-dark);
  }

  /* The handwritten line: a person, not a template. */
  /* A second line in the same face at its lightest weight: contrast by weight, not by a new font. */
  .hero__script {
    margin-block-start: 0.1em;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1rem + 5.4vw, 6rem);
    font-weight: 200;
    line-height: 1.05;
    color: var(--blue-light);
    width: fit-content;
  }

  :global([dir='rtl']) .hero__script {
    font-weight: 300;
    font-size: clamp(2rem, 1rem + 4.2vw, 4.75rem);
    line-height: 1.5;
    transform-origin: right;
  }

  .hero__lead {
    max-width: 36rem;
    margin-block-start: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
    color: var(--navy-text);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-snug);
  }

  :global([dir='rtl']) .hero__lead {
    font-weight: 400;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__socials {
    display: inline-flex;
    gap: var(--space-2);
    margin-inline-start: var(--space-2);
  }

  .hero__social {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    color: var(--mist);
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .hero__social:hover {
    border-color: var(--white);
    background: var(--white);
    color: var(--navy);
  }

  /* ---------- Motion ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .hero__rise {
      animation: rise 1000ms var(--ease-out) both;
      animation-delay: calc(150ms + var(--i) * 100ms);
    }

    .hero__script.hero__rise {
      animation: write 1400ms var(--ease-out) both;
      animation-delay: 450ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  /* The script line is written in, in its own direction. */
  @keyframes write {
    from {
      clip-path: inset(-20% 100% -20% 0);
    }
    to {
      clip-path: inset(-20% -5% -20% -5%);
    }
  }

  :global([dir='rtl']) .hero__script.hero__rise {
    animation-name: write-rtl;
  }

  @keyframes write-rtl {
    from {
      clip-path: inset(-20% 0 -20% 100%);
    }
    to {
      clip-path: inset(-20% -5% -20% -5%);
    }
  }

  @keyframes pulse {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3);
    }
  }

</style>

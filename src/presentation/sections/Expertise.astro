---
import type { ExpertiseGroup } from '@/domain/entities/career';
import type { Locale } from '@/domain/entities/locale';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  groups: ExpertiseGroup[];
}

const { locale, groups } = Astro.props;
const t = useUi(locale);
const pad = (n: number, size = 2) => String(n).padStart(size, '0');
---

<section class="xp theme-dark" id="expertise" aria-labelledby="xp-title" data-xp>
  <div class="wrap xp__content">
    <header class="xp__head">
      <div>
        <p class="eyebrow"><span>04</span> / {t.nav.expertise}</p>
        <h2 class="xp__title" id="xp-title">{t.expertise.title}<span class="xp__dot">.</span></h2>
        <p class="xp__script">{t.expertise.script}</p>
      </div>
      <p class="xp__intro">{t.expertise.intro}</p>
    </header>
  </div>

  <!-- The number lives only alongside the list, so it never sits behind the heading.
       A screen-sized layer stays put while the list scrolls over it: glyphs gather into
       the number of the item being read, on the reading-start side (scripts/expertise.ts). -->
  <div class="xp__stage">
    <div class="xp__backdrop" aria-hidden="true">
      <canvas
        data-glyph-field
        data-align="start"
        data-valign="start"
        data-fill="0.5"
        data-xp-field
        data-shape={JSON.stringify({ kind: 'text', text: pad(1, 3), weight: 800 })}></canvas>
    </div>

    <div class="wrap xp__content">
      <ol class="xp__list">
        {
          groups.map((group, i) => (
            <li class="xp__item" data-xp-item data-active={i === 0 ? '' : undefined}>
              <span class="xp__mark" aria-hidden="true" />
              <p class="xp__num">{pad(i + 1)}</p>
              <h3 class="xp__name">{group.title}</h3>
              <p class="xp__body">{group.body}</p>
              <ul class="xp__tools" dir="ltr" aria-label={t.expertise.toolsLabel}>
                {group.tools.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .xp {
    position: relative;
    padding-block: 0 var(--section-pad);
    background: var(--navy-deep);
  }

  .xp__head {
    padding-block-start: var(--section-pad);
    display: grid;
    gap: var(--space-5);
    margin-block-end: var(--space-8);
  }

  .xp__title {
    margin-block-start: var(--space-3);
    font-size: clamp(2.4rem, 1rem + 5.5vw, 6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  :global([dir='rtl']) .xp__title {
    line-height: 1.3;
    letter-spacing: 0;
  }

  .xp__dot {
    color: var(--red-on-dark);
  }

  /* A second line in the same face at its lightest weight. */
  .xp__script {
    margin-block-start: 0.15em;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1rem + 2.4vw, 3rem);
    font-weight: 200;
    line-height: 1.15;
    color: var(--blue-light);
  }

  :global([dir='rtl']) .xp__script {
    font-weight: 300;
    line-height: 1.6;
  }

  .xp__intro {
    max-width: 34ch;
    color: var(--navy-text);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-snug);
    align-self: end;
  }

  /* ---------- Number and list ---------- */

  .xp__stage {
    position: relative;
  }

  .xp__backdrop {
    position: sticky;
    inset-block-start: 0;
    z-index: 0;
    height: 100vh;
    margin-block-end: -100vh;
    pointer-events: auto;
  }

  .xp__backdrop canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  .xp__content {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .xp__content a,
  .xp__content .xp__item {
    pointer-events: auto;
  }

  /* The list keeps to the reading-end half; the number owns the other side. */
  .xp__list {
    position: relative;
    width: min(100%, 38rem);
    margin-inline-start: auto;
    border-block-start: 1px solid var(--line-dark);
  }

  .xp__item {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6);
    border-block-end: 1px solid var(--line-dark);
    border-inline-start: 1px solid var(--line-dark);
    opacity: 0.45;
    transition: opacity 700ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .xp__item[data-active] {
    opacity: 1;
  }

  /* The line: a bright segment along the item being read. */
  .xp__mark {
    position: absolute;
    inset-block: -1px;
    inset-inline-start: -1px;
    width: 2px;
    background: var(--red-on-dark);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 800ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .xp__item[data-active] .xp__mark {
    transform: scaleY(1);
  }

  .xp__num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--blue-light);
  }

  .xp__item[data-active] .xp__num {
    color: var(--red-on-dark);
  }

  .xp__name {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--white);
  }

  .xp__body {
    max-width: 46ch;
    color: var(--navy-text);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: var(--leading-body);
  }

  :global([dir='rtl']) .xp__body {
    font-weight: 400;
  }

  .xp__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: var(--space-2);
  }

  :global([dir='rtl']) .xp__tools {
    justify-content: flex-end;
  }

  .xp__tools li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  @media (min-width: 60rem) {
    .xp__head {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .xp__item {
      opacity: 1;
    }
  }
</style>

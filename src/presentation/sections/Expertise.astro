---
import type { ExpertiseGroup } from '@/domain/entities/career';
import type { Locale } from '@/domain/entities/locale';
import ToolList from '@/presentation/components/ToolList.astro';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  groups: ExpertiseGroup[];
}

const { locale, groups } = Astro.props;
const t = useUi(locale);
---

<section class="section theme-mist" id="expertise">
  <div class="wrap">
    <header class="expertise__head">
      <h2 class="section__title">{t.expertise.title}</h2>
      <p class="section__intro">{t.expertise.intro}</p>
    </header>

    <ul class="expertise__list">
      {
        groups.map((group) => (
          <li class="expertise__item">
            <h3>{group.title}</h3>
            <div class="expertise__text">
              <p>{group.body}</p>
              <ToolList tools={group.tools} label={t.expertise.toolsLabel} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .expertise__head {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-7);
  }

  .expertise__list {
    border-block-start: 1px solid var(--rule);
  }

  .expertise__item {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--rule);
  }

  .expertise__item h3 {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .expertise__text {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  @media (min-width: 56rem) {
    .expertise__item {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-7);
      align-items: baseline;
    }
  }
</style>

---
/**
 * One overlay, two jobs:
 *
 *  - Loader, on the first page of a visit: the bar of the mark fills as the
 *    page loads, a rolling counter goes 000 to 100, the bubble pops, then the
 *    curtain leaves.
 *  - Page transition, on every internal link: two panels cut at the angle of
 *    the bar sweep across, the mark draws itself, the next page opens under
 *    the same curtain and the panels sweep on.
 *
 * The overlay is hidden unless the inline script in BaseLayout puts a
 * `pt-load` or `pt-enter` class on <html> before first paint. Without
 * JavaScript, or with reduced motion, it never shows.
 * Behaviour lives in scripts/curtain.ts.
 *
 * On a case study the transition turns into the app's own splash: its
 * colour, its logo, a short loading bar (`splash`). The same markup is
 * built by curtain.ts when a link to a project is followed.
 */
import LogoMark from '@/presentation/components/LogoMark.astro';
import type { SplashData } from '@/presentation/features/case-study/splash';

interface Props {
  name: string;
  role: string;
  splash?: SplashData;
}

const { name, role, splash } = Astro.props;
const splashStyle = splash
  ? `--splash:${splash.primary};--splash-deep:${splash.deep};--splash-accent:${splash.accent};--splash-on:${splash.on}`
  : undefined;
const digits = Array.from({ length: 10 }, (_, i) => i);
---

<div class="curtain" data-curtain aria-hidden="true" data-has-splash={splash ? '' : undefined} style={splashStyle}>
  <div class="curtain__panel curtain__panel--accent" data-curtain-panel></div>
  <div class="curtain__panel curtain__panel--main" data-curtain-panel>
    <div class="curtain__meta curtain__meta--top" data-curtain-meta>
      <span>{name}</span>
      <span>{role}</span>
    </div>

    <div class="curtain__logo" data-curtain-logo>
      <LogoMark progress />
    </div>

    <div class="curtain__meta curtain__meta--bottom" data-curtain-meta>
      <div class="curtain__counter" data-curtain-counter dir="ltr">
        <span class="curtain__col curtain__col--hundreds"><span>0</span><span>1</span></span>
        <span class="curtain__col">{[...digits, 0].map((d) => <span>{d}</span>)}</span>
        <span class="curtain__col">{[...digits, 0].map((d) => <span>{d}</span>)}</span>
      </div>
      <span class="curtain__hint" dir="ltr">Flutter · Arabic-first</span>
    </div>

    {
      splash && (
        <div class="splash" data-splash>
          {splash.logo ? (
            <img class:list={['splash__logo', `splash__logo--${splash.kind}`]} src={splash.logo} alt="" decoding="sync" />
          ) : (
            <span class="splash__word">{splash.name}</span>
          )}
          <span class="splash__bar">
            <i />
          </span>
        </div>
      )
    }
  </div>
</div>

<style is:global>
  /*
   * The bar of the mark leans by 93.33 units across for every 184.71 up.
   * Every slanted edge in the curtain uses the same lean, so the panels
   * look cut from the logo itself.
   */
  :root {
    --lean-x: calc(0.5053 * 100vh);
  }

  .curtain {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  html.pt-load .curtain,
  html.pt-enter .curtain,
  html.pt-leave .curtain {
    display: block;
    pointer-events: auto;
  }

  /* While the panels sweep off, the page underneath is already live. */
  html.pt-revealing .curtain {
    display: block;
  }

  html.pt-revealing .curtain .mark__bar {
    clip-path: none;
  }

  .curtain__panel {
    position: absolute;
    inset: 0;
    /* Fully covering. The script animates the four x positions. */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .curtain__panel--accent {
    background: var(--blue);
  }

  /* ---------- App splash, for case studies ---------- */

  .curtain[data-has-splash] .curtain__panel--accent {
    background: var(--splash-accent);
  }

  .splash {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--white) 12%, transparent), transparent 55%),
      var(--splash);
    color: var(--splash-on);
  }

  /* The splash shows whenever the curtain is not the first-visit loader. */
  html.pt-enter .curtain[data-has-splash] .splash,
  html.pt-leave .curtain[data-has-splash] .splash,
  html.pt-revealing .curtain[data-has-splash] .splash {
    display: flex;
  }

  .splash__logo--wordmark {
    width: min(62vw, 26rem);
    height: auto;
  }

  .splash__logo--icon {
    width: min(34vw, 9rem);
    height: auto;
    padding: 0.6rem;
    border-radius: 28%;
    background: var(--white);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5);
  }

  .splash__word {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 8vw, 7rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .splash__bar {
    position: relative;
    width: 4.5rem;
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--splash-on) 25%, transparent);
    overflow: hidden;
  }

  .splash__bar i {
    position: absolute;
    inset: 0;
    width: 40%;
    border-radius: inherit;
    background: var(--splash-accent);
    animation: splash-bar 1.1s var(--ease-in-out) infinite;
  }

  @keyframes splash-bar {
    from {
      translate: -110% 0;
    }
    to {
      translate: 260% 0;
    }
  }

  .curtain__panel--main {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1.25rem, 0.6rem + 2.6vw, 2.5rem) var(--gutter);
    background: var(--navy-deep);
    color: var(--white);
  }

  /* Leaving a page starts with both panels waiting off the start edge. */
  html.pt-leave .curtain__panel {
    clip-path: polygon(0 0, 0 0, calc(var(--lean-x) * -1) 100%, calc(var(--lean-x) * -1) 100%);
  }

  /* Outside the loader the bar is always whole. */
  html.pt-enter .curtain .mark__bar,
  html.pt-leave .curtain .mark__bar {
    clip-path: none;
  }

  .curtain__meta {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--navy-text);
  }

  html.pt-enter .curtain__meta,
  html.pt-leave .curtain__meta {
    visibility: hidden;
  }

  .curtain__logo {
    align-self: center;
    justify-self: center;
    width: clamp(5.5rem, 4rem + 6vw, 8.5rem);
    --mark-bubble: var(--blue-light);
  }

  .curtain__logo .mark__bubble {
    opacity: 0.16;
  }

  /* Between pages only the slanted panels move; the mark belongs to the first visit. */
  html.pt-enter .curtain__logo,
  html.pt-leave .curtain__logo,
  html.pt-revealing .curtain__logo {
    visibility: hidden;
  }

  .curtain__counter {
    display: flex;
    height: 1em;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 9vw, 10rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .curtain__col {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .curtain__col > span {
    display: block;
    height: 1em;
  }

  .curtain__hint {
    padding-block-end: 0.6em;
  }

  /*
   * Hold the page's own entrance animations until the curtain has gone,
   * so the hero still writes itself in front of the visitor.
   */
  html.pt-load main *,
  html.pt-enter main *,
  html.pt-load main *::before,
  html.pt-enter main *::before {
    animation-play-state: paused !important;
  }
</style>

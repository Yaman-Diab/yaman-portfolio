---
import type { ProjectStatus } from '@/domain/entities/project';

interface Props {
  status: ProjectStatus;
  label: string;
}

const { status, label } = Astro.props;
---

<span class={`status status--${status}`}>
  <span class="nuqta" aria-hidden="true"></span>
  {label}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }

  .status .nuqta {
    font-size: 0.85em;
  }

  .status--live .nuqta {
    color: var(--ok);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .status--in-development .nuqta {
    color: var(--accent-warm);
  }

  .status--source-available .nuqta {
    color: currentColor;
  }

  /* Paused: a hollow marker. */
  .status--paused .nuqta {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
</style>

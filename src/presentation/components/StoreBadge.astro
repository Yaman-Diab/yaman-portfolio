---
/**
 * "Get it on Google Play": the store's mark and two lines of type in a black
 * badge, the way stores ask for it to be shown. Leans toward the pointer.
 */
import type { Locale } from '@/domain/entities/locale';

interface Props {
  href: string;
  locale: Locale;
}

const { href, locale } = Astro.props;
const small = locale === 'ar' ? 'احصل عليه من' : 'GET IT ON';
---

<a class="store-badge" href={href} rel="noopener" data-magnetic="0.25" aria-label="Google Play">
  <span class="store-badge__inner" data-magnetic-label>
    <svg class="store-badge__logo" viewBox="0 0 24 26" aria-hidden="true">
      <path fill="#2196f3" d="M1.4.9 13.6 13 1.4 25.1c-.3-.3-.4-.8-.4-1.4V2.3c0-.6.1-1.1.4-1.4Z" />
      <path fill="#00c853" d="M1.4.9c.5-.5 1.3-.5 2.2 0L17.9 9l-4.3 4Z" />
      <path fill="#f44336" d="M1.4 25.1 13.6 13l4.3 4-14.3 8.1c-.9.5-1.7.5-2.2 0Z" />
      <path fill="#ffc107" d="m17.9 9 4.5 2.6c1.2.7 1.2 2.1 0 2.8L17.9 17l-4.3-4Z" />
    </svg>
    <span class="store-badge__text">
      <small>{small}</small>
      <strong dir="ltr">Google Play</strong>
    </span>
  </span>
</a>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    min-height: 3.6rem;
    padding: 0.55rem 1.4rem 0.55rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    background: #000;
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 18px 36px -18px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur) ease;
  }

  .store-badge:hover {
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow:
      0 24px 44px -18px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .store-badge__inner {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .store-badge__logo {
    width: 1.7rem;
    height: auto;
    flex: none;
  }

  .store-badge__text {
    display: grid;
    line-height: 1.1;
    text-align: start;
  }

  .store-badge__text small {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  :global([dir='rtl']) .store-badge__text small {
    font-size: 0.72rem;
    letter-spacing: 0;
  }

  .store-badge__text strong {
    font-family: 'IBM Plex Sans', var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>

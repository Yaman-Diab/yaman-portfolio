---
import '@/presentation/styles/base.css';
import displayLatinFont from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import displayArabicFont from '@fontsource-variable/alexandria/files/alexandria-arabic-wght-normal.woff2?url';
import bodyLatinFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import bodyArabicFont from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import { absoluteUrl, routes } from '@/app/routes';
import { LOCALES, directionOf, otherLocale, type Locale } from '@/domain/entities/locale';
import type { Profile } from '@/domain/entities/profile';
import CursorGlow from '@/presentation/components/CursorGlow.astro';
import PageCurtain from '@/presentation/components/PageCurtain.astro';
import type { SplashData } from '@/presentation/features/case-study/splash';
import SiteFooter from '@/presentation/components/SiteFooter.astro';
import SiteHeader from '@/presentation/components/SiteHeader.astro';
import { useUi } from '@/presentation/i18n/ui';

interface Props {
  locale: Locale;
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  profile: Profile;
  /** The address of this same page in a given language. */
  pathFor: (locale: Locale) => string;
  /** On a case study: the app's splash, shown by the page transition. */
  splash?: SplashData;
}

const { locale, title, description, profile, pathFor, splash } = Astro.props;
const t = useUi(locale);
const dir = directionOf(locale);

const siteName = `${profile.name}${t.comma}${profile.role}`;
const pageTitle = title ? `${title} | ${profile.name}` : siteName;
const canonical = absoluteUrl(pathFor(locale), Astro.site);
const socialImage = absoluteUrl(routes.asset('og.png'), Astro.site);

// The fonts needed for the first screen. The rest load on demand.
const preloads = locale === 'ar' ? [displayArabicFont, bodyArabicFont] : [displayLatinFont, bodyLatinFont];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.nameLatin,
  alternateName: profile.nameArabic,
  jobTitle: 'Flutter Developer',
  url: absoluteUrl(routes.home('en'), Astro.site),
  image: socialImage,
  email: `mailto:${profile.contact.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Damascus', addressCountry: 'SY' },
  knowsLanguage: ['ar', 'en'],
  sameAs: [profile.contact.github, profile.contact.linkedin],
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.nameLatin} />
    <meta name="theme-color" content="#f9f7f7" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={absoluteUrl(pathFor(code), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(pathFor('en'), Astro.site)} />

    <link rel="icon" href={routes.asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={routes.asset('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={routes.asset('apple-touch-icon.png')} />
    <link rel="sitemap" href={routes.asset('sitemap-index.xml')} />

    {preloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.nameLatin} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_SY' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLocale(locale) === 'ar' ? 'ar_SY' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Decide before first paint whether the page opens under the curtain (PageCurtain.astro):
        // the loader on the first page of a visit, the logo transition after an internal link.
        // The navigation flag is used once and always cleared, so it never leaks into a later visit.
        // The logo intro plays when the site is first opened in a tab, on a refresh, or after
        // a click on the logo. Every other move between pages gets only the slanted lines.
        var mode = null;
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var reload = nav && nav.type === 'reload';
          var logo = sessionStorage.getItem('pt-logo');
          if (logo || reload || !sessionStorage.getItem('pt-seen')) mode = 'load';
          else if (sessionStorage.getItem('pt-nav')) mode = 'enter';
          sessionStorage.removeItem('pt-nav');
          sessionStorage.removeItem('pt-logo');
          sessionStorage.setItem('pt-seen', '1');
        } catch (e) {
          mode = null; /* storage blocked: no loader, plain navigation */
        }
        if (mode && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('pt-' + mode);
          // Never trap anyone behind the curtain if its script fails to load. curtain.ts cancels this.
          window.__curtainFailsafe = setTimeout(function () {
            root.classList.remove('pt-load', 'pt-enter');
          }, 10000);
        }
      })();
    </script>
  </head>
  <body>
    <PageCurtain name={profile.name} role={profile.role} splash={splash} />
    <a class="skip-link" href="#main">{t.skip}</a>
    <SiteHeader locale={locale} profile={profile} alternateHref={pathFor(otherLocale(locale))} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} profile={profile} alternateHref={pathFor(otherLocale(locale))} />
    <CursorGlow />
    <script>
      import '@/presentation/scripts/curtain';
      import '@/presentation/scripts/device';
      import '@/presentation/scripts/site';
    </script>
  </body>
</html>
